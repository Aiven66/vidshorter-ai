{
  "buildCommand": "pnpm next build",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "framework": "nextjs",
  "regions": ["hkg1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 300
    }
  },
  "build": {
    "env": {
      "VERCEL": "1"
    }
  },
  "crons": [
    {
      "path": "/api/blog/auto-publish",
      "schedule": "0 0 * * *"
    }
  ]
}
