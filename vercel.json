{
  "buildCommand": "pnpm next build && node scripts/patch-native-nft.mjs",
  "installCommand": "ONNXRUNTIME_NODE_INSTALL=skip pnpm install --no-frozen-lockfile",
  "framework": "nextjs",
  "regions": [
    "hkg1"
  ],
  "functions": {
    "src/app/api/**/route.ts": {
      "maxDuration": 300
    }
  },
  "build": {
    "env": {
      "VERCEL": "1"
    }
  },
  "crons": [
    {
      "path": "/api/blog/auto-publish",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/subscription-expiry",
      "schedule": "0 1 * * *"
    }
  ]
}