# =============================================
# 基础配置
# =============================================
NEXT_PUBLIC_APP_URL=
APP_BASE_URL=
CF_WORKER_URL=
NEXT_PUBLIC_DESKTOP_WEB_APP_URL=

# =============================================
# Supabase
# =============================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=uploads

# =============================================
# 定价与支付配置
# =============================================
# Creem 支付配置（海外用户）
# 获取方式：https://creem.io/dashboard/developers
CREEM_API_KEY=creem_your-api-key
CREEM_WEBHOOK_SECRET=whsec_your-webhook-secret
CREEM_PRODUCT_IDS={"starter":"prod_starter-id","pro":"prod_pro-id"}

# Waffo Pancake 支付配置（MoR，作为 Creem 之外的补充渠道）
# 后台：https://merchant.waffo.ai ；集成指引：https://docs.waffo.ai/zh/integrate/skill
# PRIVATE_KEY 为 RSA 私钥，切勿提交到 git、切勿在对话中回传
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_STORE_ID=
# test | prod（默认 test）
WAFFO_ENVIRONMENT=test
# 订阅商品 ID 映射，JSON：{"starter":"PROD_xxx","pro":"PROD_yyy"}
# 由 scripts/waffo-setup.ts 创建商品后自动打印，直接粘贴到此处
WAFFO_PRODUCT_IDS=
# API base URL 覆盖（默认 https://api.waffo.ai，一般无需配置）
# WAFFO_BASE_URL=

# PayPal 支付配置（生产环境配置后即可启用）
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# PAYPAL_ENV=sandbox
# NEXT_PUBLIC_PAYPAL_CURRENCY=USD

# 支付宝支付配置（前端暂时隐藏支付宝入口，保留后端配置以便后续恢复）
# 获取方式：https://open.alipay.com/
# ALIPAY_APP_ID=20210001xxxx
# ALIPAY_PRIVATE_KEY=your-private-key
# ALIPAY_PUBLIC_KEY=alipay-public-key
# ALIPAY_NOTIFY_URL=https://your-app.vercel.app/api/payment/alipay
# ALIPAY_SANDBOX=true
# 线上只使用直连商户的 alipay.trade.page.pay 电脑网站支付。
# 不要配置 app_auth_token/ISV/当面付预创建二维码，否则容易触发 insufficient-isv-permissions。
# ALIPAY_PAYMENT_MODE=page

# =============================================
# 异步视频处理队列 (QStash)
# 作用：把视频生成拆成「分析 + 逐条片段」微任务，杜绝单次 300s/60s 超时卡死。
# 获取方式：https://console.upstash.com/qstash → Create
# 未配置时自动降级为 waitUntil 后台执行（本地可用），配置后切到持久化队列。
# 线上务必配置，否则长视频仍受单函数超时上限制约。
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# 队列 webhook 自动挂在 /api/videos/process/worker（地址从 NEXT_PUBLIC_APP_URL/VERCEL_URL 推导）

# =============================================
# 邮件 (SMTP)
# =============================================
# EMAIL_PROVIDER=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=true
# SMTP_FROM=

# =============================================
# 其他
# =============================================
# 服务端 API Key（管理接口）
ADMIN_API_KEY=
# 数据埋点 (PostHog)
# NEXT_PUBLIC_POSTHOG_API_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# 本地 Agent 广播地址
NEXT_PUBLIC_SERVER_URL=
SERVER_URL=
# 异步任务"卡死"判定时长（毫秒，默认 25 分钟）
# PROCESS_STALE_MS=1500000