{
  "name": "clipop-macos-agent",
  "private": true,
  "version": "0.9.66",
  "main": "main.js",
  "scripts": {
    "prepare:runner": "node scripts/prepare-runner.js",
    "prepare:whisper": "node scripts/prepare-whisper.js",
    "finalize:mac": "node scripts/finalize-mac-app.js",
    "prebuild:dmg": "node scripts/cleanup-dmg-mounts.js",
    "dist:dmg:fallback": "node scripts/build-dmg-hybrid.js",
    "dev": "pnpm prepare:runner && electron .",
    "start": "electron .",
    "dist": "pnpm prepare:runner && (pnpm prebuild:dmg || true) && (electron-builder --mac --arm64 || pnpm dist:dmg:fallback)",
    "dist:zip": "pnpm prepare:runner && electron-builder --mac --arm64 --config.mac.target=zip",
    "pack": "electron-builder --mac --arm64 --dir",
    "dist:x64": "pnpm prepare:runner && electron-builder --mac --x64",
    "test": "node scripts/test-desktop.js",
    "test:realhuman": "node scripts/test-real-human-quality.js",
    "test:ytdlp": "node scripts/check-ytdlp-strategies.js",
    "test:local-highlights": "node scripts/check-local-highlights-generated.js",
    "test:local-asr": "node scripts/test-local-asr.js",
    "test:local-signals": "node scripts/check-local-signals.js",
    "test:local-render": "node scripts/test-local-render.js"
  },
  "build": {
    "appId": "com.clipop.macos-agent",
    "productName": "Clipop Agent",
    "directories": {
      "output": "dist"
    },
    "afterPack": "scripts/after-pack.js",
    "asar": true,
    "asarUnpack": [
      "bin/**",
      "node_modules/@ffmpeg-installer/**",
      "node_modules/onnxruntime-node/**"
    ],
    "extraResources": [
      {
        "from": "embedded-web",
        "to": "embedded-web",
        "filter": [
          "**/*",
          "!**/.data/**",
          "!**/generated-clips/**",
          "!**/*.mp4",
          "!**/*.map",
          "!**/node_modules/.pnpm/@ffmpeg-installer+*/**",
          "!**/node_modules/.pnpm/typescript@*/**",
          "!**/node_modules/.pnpm/@esbuild+*/**",
          "!**/node_modules/.pnpm/webpack@*/**",
          "!**/node_modules/.pnpm/caniuse-lite@*/**",
          "!**/node_modules/.pnpm/terser@*/**",
          "!**/node_modules/.pnpm/meriyah@*/**",
          "!**/node_modules/.pnpm/enhanced-resolve@*/**",
          "!**/node_modules/.pnpm/@img+sharp-linux*/**",
          "!**/node_modules/.pnpm/@img+sharp-libvips-linux*/**",
          "!**/node_modules/.pnpm/@img+sharp-win32*/**",
          "!**/node_modules/.pnpm/@img+sharp-libvips-win32*/**",
          "!**/node_modules/.pnpm/@img+sharp-darwin-x64*/**",
          "!**/node_modules/.pnpm/@img+sharp-libvips-darwin-x64*/**",
          "!**/node_modules/.pnpm/@img+sharp-wasm32*/**",
          "!**/node_modules/.pnpm/@img+sharp-android*/**",
          "!**/node_modules/.pnpm/@img+sharp-libvips-android*/**"
        ]
      },
      {
        "from": "resources/hosts",
        "to": "hosts",
        "filter": [
          "**/*.mp4"
        ]
      },
      {
        "from": "resources/sherpa-onnx",
        "to": "sherpa-onnx",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/musetalk-local",
        "to": "musetalk-runtime",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "preload-web.js",
      "ytdlp.js",
      "runner.js",
      "local-highlights.js",
      "local-models.js",
      "local-asr.js",
      "local-signals.js",
      "local-highlight-scorer.js",
      "local-highlight-rules.js",
      "local-render.js",
      "media-server.js",
      "real-human-engine.js",
      "real-human-ipc.js",
      "local-product-avatar.js",
      "i18n.js",
      "package.json",
      "icon.png",
      "bin/**",
      "renderer/**",
      "node_modules/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "https-proxy-agent": "^7.0.5",
    "onnxruntime-node": "^1.27.0",
    "ws": "^8.21.3"
  }
}